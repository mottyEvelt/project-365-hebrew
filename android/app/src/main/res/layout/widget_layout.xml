<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:paddingBottom="6dp"
        android:text="It's 13th Jan."
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="normal" />

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="352 days left"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="normal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="|"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_percent_passed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.6% passed"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="normal" />
    </LinearLayout>

    <GridView
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_date"
        android:layout_above="@id/widget_footer"
        android:clipToPadding="false"
        android:columnWidth="20dp"
        android:gravity="center_horizontal" 
        android:horizontalSpacing="0dp"
        android:numColumns="auto_fit"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp" />

</RelativeLayout>